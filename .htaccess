# Para cuando el sitio se publique en un servidor Apache (centromedicomg.com.ar).
# Hace que las direcciones viejas sin ".html" (las de los QR impresos, como /planes)
# sigan abriendo la página correcta.
Options -MultiViews
RewriteEngine On

# /planes.html -> /planes (una sola dirección por página)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /planes y /planes/ -> planes.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
